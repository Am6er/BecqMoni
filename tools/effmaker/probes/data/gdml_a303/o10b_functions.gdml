<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define><constant name="a" value="sqrt(16)"/><constant name="b" value="2^3"/><constant name="c" value="pow(2,3)+abs(-1)+sin(0)"/></define>
<materials></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><box name="B" x="a" y="b" z="c"/></solids>
<structure><volume name="L1"><materialref ref="G4_Fe"/><solidref ref="B"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="a1"><volumeref ref="L1"/><position x="100"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
