<?xml version="1.0"?><gdml><define><position name="pA" x="0" y="0" z="30*sin(pi/2)"/></define><solids><box name="WB" x="2000" y="2000" z="2000" lunit="mm"/><box name="P" x="20*sin(30*deg)" y="10*cos(0)" z="atan2(1,1)*40/pi" lunit="mm"/></solids><structure><volume name="A"><materialref ref="G4_Al"/><solidref ref="P"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="pv_A"><volumeref ref="A"/><positionref ref="pA"/></physvol></volume></structure><setup name="Default" version="1.0"><world ref="World"/></setup></gdml>
