<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define><position name="v0" x="0" y="0" z="0" unit="mm"/><position name="v1" x="10" y="0" z="0" unit="mm"/><position name="v2" x="10" y="10" z="0" unit="mm"/><position name="v3" x="0" y="10" z="0" unit="mm"/><position name="v4" x="0" y="0" z="10" unit="mm"/><position name="v5" x="10" y="0" z="10" unit="mm"/><position name="v6" x="10" y="10" z="10" unit="mm"/><position name="v7" x="0" y="10" z="10" unit="mm"/></define>
<materials></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><tessellated name="T1" aunit="deg" lunit="mm"><quadrangular vertex1="v0" vertex2="v3" vertex3="v2" vertex4="v1" type="ABSOLUTE"/><quadrangular vertex1="v4" vertex2="v5" vertex3="v6" vertex4="v7" type="ABSOLUTE"/><quadrangular vertex1="v0" vertex2="v1" vertex3="v5" vertex4="v4" type="ABSOLUTE"/><quadrangular vertex1="v1" vertex2="v2" vertex3="v6" vertex4="v5" type="ABSOLUTE"/><quadrangular vertex1="v2" vertex2="v3" vertex3="v7" vertex4="v6" type="ABSOLUTE"/><quadrangular vertex1="v3" vertex2="v0" vertex3="v4" vertex4="v7" type="ABSOLUTE"/></tessellated><tessellated name="T2" aunit="deg" lunit="mm"><quadrangular vertex1="v0" vertex2="v3" vertex3="v2" vertex4="v1" type="ABSOLUTE" lunit="cm"/><quadrangular vertex1="v4" vertex2="v5" vertex3="v6" vertex4="v7" type="ABSOLUTE" lunit="cm"/><quadrangular vertex1="v0" vertex2="v1" vertex3="v5" vertex4="v4" type="ABSOLUTE" lunit="cm"/><quadrangular vertex1="v1" vertex2="v2" vertex3="v6" vertex4="v5" type="ABSOLUTE" lunit="cm"/><quadrangular vertex1="v2" vertex2="v3" vertex3="v7" vertex4="v6" type="ABSOLUTE" lunit="cm"/><quadrangular vertex1="v3" vertex2="v0" vertex3="v4" vertex4="v7" type="ABSOLUTE" lunit="cm"/></tessellated></solids>
<structure><volume name="L1"><materialref ref="G4_Fe"/><solidref ref="T1"/></volume><volume name="L2"><materialref ref="G4_Fe"/><solidref ref="T2"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="a"><volumeref ref="L1"/><position x="100"/></physvol><physvol name="b"><volumeref ref="L2"/><position x="-200"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
