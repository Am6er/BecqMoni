<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><genericPolycone name="G1" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><rzpoint r="0" z="0"/><rzpoint r="10" z="0"/><rzpoint r="10" z="5"/><rzpoint r="5" z="5"/><rzpoint r="5" z="10"/><rzpoint r="0" z="10"/></genericPolycone><genericPolycone name="G2" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><rzpoint r="0" z="10"/><rzpoint r="5" z="10"/><rzpoint r="5" z="5"/><rzpoint r="10" z="5"/><rzpoint r="10" z="0"/><rzpoint r="0" z="0"/></genericPolycone></solids>
