<?xml version="1.0"?><gdml><define><variable name="i" value="1"/></define><solids><box name="WB" x="2000" y="2000" z="2000" lunit="mm"/><polycone name="P" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><zplane z="0" rmin="0" rmax="5"/><zplane z="50" rmin="0" rmax="5"/></polycone><loop for="i" from="1" to="3" step="1"><box name="B[i]" x="1" y="1" z="1"/></loop><opticalsurface name="os" model="glisur" finish="polished" type="dielectric_metal" value="1"/></solids><structure><volume name="A"><materialref ref="G4_Al"/><solidref ref="P"/><loop for="i" from="1" to="3" step="1"></loop></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="pv_A"><volumeref ref="A"/></physvol></volume></structure><setup name="Default" version="1.0"><world ref="World"/></setup></gdml>