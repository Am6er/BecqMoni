<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define></define>
<materials><material name="Al" Z="13"><D value="2.7"/><atom value="26.98"/></material></materials>
<solids>
<box name="W" lunit="mm" x="4000" y="4000" z="4000"/>
<tube name="A" rmin="5" rmax="20" z="60" deltaphi="360" aunit="deg"/><cone name="C" rmax1="20" rmax2="5" z="30" deltaphi="360" aunit="deg"/><union name="S"><first ref="A"/><second ref="C"/><position x="0" y="0" z="45"/></union>
</solids>
<structure>
<volume name="V"><materialref ref="Al"/><solidref ref="S"/></volume>
<volume name="World"><materialref ref="G4_AIR"/><solidref ref="W"/><physvol name="pv"><volumeref ref="V"/><position name="p" x="0" y="0" z="0"/></physvol></volume>
</structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
