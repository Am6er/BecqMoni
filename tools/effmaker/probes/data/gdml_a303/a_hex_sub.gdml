<?xml version="1.0"?>
<gdml>
<define/>
<materials><material name="Al" Z="13"><D value="2.7"/><atom value="26.98"/></material></materials>
<solids>
<box name="W" lunit="mm" x="4000" y="4000" z="4000"/>
<tube name="A0x1234" rmax="10" z="30" deltaphi="360" aunit="deg"/><box name="C0xabcd" x="2" y="2" z="2"/><subtraction name="S"><first ref="A0x1234"/><second ref="C0xabcd"/></subtraction>
</solids>
<structure>
<volume name="V"><materialref ref="Al"/><solidref ref="S"/></volume>
<volume name="World"><materialref ref="Al"/><solidref ref="W"/><physvol name="pv"><volumeref ref="V"/></physvol></volume>
</structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
