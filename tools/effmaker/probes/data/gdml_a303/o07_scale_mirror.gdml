<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define></define>
<materials></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><polycone name="P" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><zplane z="10" rmax="5"/><zplane z="30" rmax="5"/></polycone></solids>
<structure><volume name="L"><materialref ref="G4_Fe"/><solidref ref="P"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="m"><volumeref ref="L"/><position x="1" y="2" z="3"/><rotation x="90" unit="deg"/><scale name="s" x="1" y="1" z="-1"/></physvol><physvol name="n"><volumeref ref="L"/><position x="100"/><scale name="s2" x="-1" y="1" z="1"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
