<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define><quantity name="dq" type="density" value="2.5" unit="g/cm3"/></define>
<materials><isotope name="U235" Z="92" N="235"><atom value="235.0439"/></isotope><isotope name="U238" Z="92" N="238"><atom value="238.0508"/></isotope><element name="Uenr"><fraction n="0.2" ref="U235"/><fraction n="0.8" ref="U238"/></element><element name="Hy" formula="H" Z="1"><atom value="1.008"/></element><element name="Ox" formula="O" Z="8"><atom value="15.999"/></element><material name="W1" state="liquid"><T value="300"/><P value="101325"/><MEE value="75" unit="eV"/><D value="1000" unit="kg/m3"/><composite n="2" ref="Hy"/><composite n="1" ref="Ox"/></material><material name="W2"><D value="1"/><fraction n="0.111894" ref="H"/><fraction n="0.888106" ref="O"/></material><material name="U1"><D value="19" unit="g/cm3"/><fraction n="1" ref="Uenr"/></material><material name="UO2"><D value="10.5"/><composite n="1" ref="Uenr"/><composite n="2" ref="O"/></material><material name="Pure" Z="29"><D value="8.96"/><atom value="63.546"/></material><material name="MixNist"><D value="5" unit="mg/cm3"/><fraction n="0.5" ref="G4_WATER"/><fraction n="0.5" ref="G4_AIR"/></material><material name="ByRef"><Dref ref="dq"/><fraction n="1" ref="Fe"/></material></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><box name="B" x="10" y="10" z="10"/></solids>
<structure><volume name="LW1"><materialref ref="W1"/><solidref ref="B"/></volume><volume name="LW2"><materialref ref="W2"/><solidref ref="B"/></volume><volume name="LU1"><materialref ref="U1"/><solidref ref="B"/></volume><volume name="LUO2"><materialref ref="UO2"/><solidref ref="B"/></volume><volume name="LPure"><materialref ref="Pure"/><solidref ref="B"/></volume><volume name="LMixNist"><materialref ref="MixNist"/><solidref ref="B"/></volume><volume name="LByRef"><materialref ref="ByRef"/><solidref ref="B"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="p0"><volumeref ref="LW1"/><position x="0"/></physvol><physvol name="p1"><volumeref ref="LW2"/><position x="30"/></physvol><physvol name="p2"><volumeref ref="LU1"/><position x="60"/></physvol><physvol name="p3"><volumeref ref="LUO2"/><position x="90"/></physvol><physvol name="p4"><volumeref ref="LPure"/><position x="120"/></physvol><physvol name="p5"><volumeref ref="LMixNist"/><position x="150"/></physvol><physvol name="p6"><volumeref ref="LByRef"/><position x="180"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
