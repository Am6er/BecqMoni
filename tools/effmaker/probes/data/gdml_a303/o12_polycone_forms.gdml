<define></define>
<materials></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><polycone name="D" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><zplane z="10" rmin="1" rmax="5"/><zplane z="0" rmin="2" rmax="7"/></polycone><polycone name="St" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><zplane z="0" rmin="0" rmax="5"/><zplane z="5" rmin="0" rmax="5"/><zplane z="5" rmin="0" rmax="9"/><zplane z="10" rmin="0" rmax="9"/></polycone><polycone name="Tip" startphi="0" deltaphi="360" aunit="deg" lunit="mm"><zplane z="0" rmin="0" rmax="0"/><zplane z="10" rmin="0" rmax="8"/></polycone></solids>
<structure><volume name="L1"><materialref ref="G4_Fe"/><solidref ref="D"/></volume><volume name="L2"><materialref ref="G4_Fe"/><solidref ref="St"/></volume><volume name="L3"><materialref ref="G4_Fe"/><solidref ref="Tip"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="a"><volumeref ref="L1"/><position x="100"/></physvol><physvol name="b"><volumeref ref="L2"/><position x="-100"/></physvol><physvol name="c"><volumeref ref="L3"/><position y="100"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
