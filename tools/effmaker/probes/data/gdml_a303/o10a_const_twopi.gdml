<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define><constant name="HALFPI" value="pi/2."/><constant name="PI" value="1.*pi"/><constant name="TWOPI" value="2.*pi"/><constant name="LL" value="2*cm"/><variable name="k" value="3"/><expression name="ee">LL/k</expression></define>
<materials></materials>
<solids><box name="WB" x="10" y="10" z="10" lunit="m"/><box name="B" x="LL" y="LL/2" z="3*mm+ee"/><polycone name="P" startphi="0" deltaphi="TWOPI" lunit="mm"><zplane z="0" rmax="5"/><zplane z="10" rmax="5"/></polycone></solids>
<structure><volume name="L1"><materialref ref="G4_Fe"/><solidref ref="B"/></volume><volume name="L2"><materialref ref="G4_Fe"/><solidref ref="P"/></volume><volume name="World"><materialref ref="G4_AIR"/><solidref ref="WB"/><physvol name="a"><volumeref ref="L1"/><position x="100"/><rotation z="HALFPI"/></physvol><physvol name="b"><volumeref ref="L2"/><position x="-100"/></physvol></volume></structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>
