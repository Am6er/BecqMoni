+            /// расчёт побитово прежний.
+            /// </summary>
+            public void Smear(EnergyCalibration calibration, FwhmCalibration fwhm)
+            {
+                if (fwhm == null || fwhm.NotCalibrated())
+                {
+                    return;
+                }
+
+                int n = this.Centres.Length;
+                int bins = this.Start.Length;
+                var first = new int[n];
+                var shares = new double[n][];
+                var moments = new double[n][];
+                bool any = false;
+                for (int j = 0; j < n; j++)
+                {
+                    double sigma = fwhm.ChannelToFwhm(j) / 2.3548200450309493;
+                    if (!(sigma > 0.0) || double.IsInfinity(sigma))
+                    {
+                        continue;
+                    }
+
+                    double reachLo = j - LeakSigmas * sigma, reachHi = j + LeakSigmas * sigma;
+                    int k0 = -1, k1 = -1;
+                    for (int k = 0; k < bins; k++)
+                    {
+                        if (this.End[k] <= this.Start[k])
+                        {
+                            continue;
+                        }
+
+                        if (this.End[k] - 0.5 > reachLo && this.Start[k] - 0.5 < reachHi)
+                        {
+                            if (k0 < 0) k0 = k;
+                            k1 = k;
+                        }
+                    }
+
+                    if (k0 < 0)
+                    {
+                        // Канал вне сетки и дальше 6σ от неё — ни в один
+                        // диапазон, как и без свёртки.
+                        first[j] = 0;
+                        shares[j] = new double[0];
+                        moments[j] = new double[0];
+                        any = true;
+                        continue;
+                    }
+
+                    var share = new double[k1 - k0 + 1];
+                    var moment = new double[k1 - k0 + 1];
+                    for (int k = k0; k <= k1; k++)
+                    {
+                        if (this.End[k] <= this.Start[k])
+                        {
+                            continue;
+                        }
+
+                        double za = (this.Start[k] - 0.5 - j) / sigma;
+                        double zb = (this.End[k] - 0.5 - j) / sigma;
+                        double f = Phi(zb) - Phi(za);
+                        if (!(f > 0.0))
+                        {
+                            continue;
+                        }
+
+                        // Среднее усечённого гаусса, каналы → кэВ калибровкой.
+                        double mean = j + sigma * (Pdf(za) - Pdf(zb)) / f;
+                        share[k - k0] = f;
+                        moment[k - k0] = f * calibration.ChannelToEnergy(mean);
+                    }
+
+                    // Пропускаемые каналы (переполнение) отсчётов не несут и у
+                    // спектра — снимается их кусок гаусса.
+                    int iLo = Math.Max(0, (int)Math.Floor(reachLo));
+                    int iHi = Math.Min(n - 1, (int)Math.Ceiling(reachHi));
+                    for (int i = iLo; i <= iHi; i++)
+                    {
+                        if (!this.Skip[i])
+                        {
+                            continue;
+                        }
+
+                        for (int k = k0; k <= k1; k++)
+                        {
+                            if (i >= this.Start[k] && i < this.End[k])
+                            {
+                                double slice = Phi((i + 0.5 - j) / sigma) - Phi((i - 0.5 - j) / sigma);
+                                share[k - k0] -= slice;
+                                moment[k - k0] -= slice * this.Centres[i];
+                            }
+                        }
+                    }
+
+                    first[j] = k0;
+                    shares[j] = share;
+                    moments[j] = moment;
+                    any = true;
+                }
+
+                if (any)
+                {
+                    this.LeakFirst = first;
+                    this.LeakShare = shares;
+                    this.LeakMoment = moments;
+                }
+            }
+
+            static double Pdf(double z)
+            {
+                return Math.Exp(-0.5 * z * z) / 2.5066282746310002;
+            }
+
+            static double Phi(double z)
+            {
+                return 0.5 * MathNet.Numerics.SpecialFunctions.Erfc(-z / 1.4142135623730951);
+            }
