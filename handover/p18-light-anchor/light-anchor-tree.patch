+        static double Interp(double[][] table, double e)
+        {
+            if (!(e > 0.0) || e <= table[0][0])
+            {
+                return table[0][1];
+            }
+
+            int last = table.Length - 1;
+            if (e >= table[last][0])
+            {
+                return table[last][1];
+            }
+
+            for (int i = 1; i <= last; i++)
+            {
+                if (e <= table[i][0])
+                {
+                    double e0 = table[i - 1][0], r0 = table[i - 1][1];
+                    double e1 = table[i][0], r1 = table[i][1];
