diff --git a/BecquerelMonitor/FullSpectrumAnalysis/FsaAnalyzer.cs b/BecquerelMonitor/FullSpectrumAnalysis/FsaAnalyzer.cs
index a48891d8..21b0415e 100644
--- a/BecquerelMonitor/FullSpectrumAnalysis/FsaAnalyzer.cs
+++ b/BecquerelMonitor/FullSpectrumAnalysis/FsaAnalyzer.cs
@@ -14562,16 +14562,39 @@ namespace BecquerelMonitor.FullSpectrumAnalysis
             return TableOf(curve) != null;
         }
 
+        static double[][] diagNaI, diagCsI;
+        static bool diagRead;
+
+        static void DiagRead()
+        {
+            if (diagRead) return;
+            diagRead = true;
+            string f = Environment.GetEnvironmentVariable("P179_LIGHT_TABLE");
+            if (string.IsNullOrEmpty(f) || !System.IO.File.Exists(f)) return;
+            var n = new System.Collections.Generic.List<double[]>();
+            var c = new System.Collections.Generic.List<double[]>();
+            foreach (string line in System.IO.File.ReadAllLines(f))
+            {
+                string[] s = line.Split(new[] { ' ', '	' }, StringSplitOptions.RemoveEmptyEntries);
+                if (s.Length < 3 || s[0].StartsWith("#")) continue;
+                double[] pt = { double.Parse(s[1], System.Globalization.CultureInfo.InvariantCulture), double.Parse(s[2], System.Globalization.CultureInfo.InvariantCulture) };
+                if (s[0] == NaI) n.Add(pt); else if (s[0] == CsI) c.Add(pt);
+            }
+            if (n.Count > 0) diagNaI = n.ToArray();
+            if (c.Count > 0) diagCsI = c.ToArray();
+        }
+
         static double[][] TableOf(string curve)
         {
+            DiagRead();
             if (curve == NaI)
             {
-                return NaITable;
+                return diagNaI ?? NaITable;
             }
 
             if (curve == CsI)
             {
-                return CsITable;
+                return diagCsI ?? CsITable;
             }
 
             return null;
