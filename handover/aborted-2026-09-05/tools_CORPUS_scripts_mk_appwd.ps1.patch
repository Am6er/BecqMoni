diff --git a/tools/CORPUS/scripts/mk_appwd.ps1 b/tools/CORPUS/scripts/mk_appwd.ps1
index 19842913..672a04e3 100644
--- a/tools/CORPUS/scripts/mk_appwd.ps1
+++ b/tools/CORPUS/scripts/mk_appwd.ps1
@@ -1,7 +1,12 @@
 ﻿# Собрать ИЗОЛИРОВАННЫЙ рабочий каталог для корпусного прогона кодом
 # приложения (TODO S1).
 #
-#   pwsh tools/CORPUS/scripts/mk_appwd.ps1 [-Bin <сборка>] [-Wd <каталог>] [-ProbeBuild <пробы>] [-Force]
+#   & 'tools\CORPUS\scripts\mk_appwd.ps1' [-Bin <сборка>] [-Wd <каталог>] [-ProbeBuild <пробы>] [-Force]
+#
+# ⛔ ЗВАТЬ ОПЕРАТОРОМ ВЫЗОВА `&` ИЗ ТЕКУЩЕЙ СЕССИИ, А НЕ `pwsh <файл>.ps1`
+#    (`T84`/`T91`): при запуске ФАЙЛОМ аргументы разбирает командная строка, а
+#    не PowerShell-парсер. Здесь массивов нет, но правило одно на все скрипты
+#    оснастки — соседний `run_appwd.ps1` на этом ломается молча со второго ключа.
 #
 # Зачем отдельный каталог, а не `bin\Debug_Codex`, где уже лежит рецепт F25 «а»:
 #
@@ -72,6 +77,12 @@ if (-not (Test-Path (Join-Path $Bin 'BecquerelMonitor.exe'))) {
 }
 
 $plan = New-AppWdPlanOrDie -Repo $repo -Bin $Bin -Wd $Wd -ProbeBuild $ProbeBuild -Store $Store
+# ⛔ ДАЛЬШЕ ПУТИ БЕРУТСЯ У ПЛАНА, А НЕ У ПАРАМЕТРОВ (05.09.2026). План приводит
+#    их к абсолютным (`Resolve-AppWdPath`), и второго мнения о том, где лежит
+#    оснастка, быть не должно: относительный `-Wd` разводил обход каталога с
+#    планом, и сборщик выносил собственную оснастку — 233 файла из 235.
+$Wd  = $plan.Wd
+$Bin = $plan.Bin
 
 # T41: СБОРКА СТАРШЕ ИСХОДНИКОВ — и это МОЛЧАЛО. 16.08.2026 в `wd_app` лежал
 # exe от 17:25, а `PowerFwhmCalibration.cs` написан в 23:35 того же дня: типа
@@ -155,17 +166,39 @@ Write-Host ("  конфигураций приборов: {0}, матриц: {1}
 #    проверка живёт в стороже, потому что прогон идёт мимо этого скрипта.
 #    `-Building`: отметки в этот момент ещё нет по замыслу — её пишут ниже,
 #    последним действием. Всё остальное сторож спрашивает в полном объёме.
-$left = Invoke-AppWdGuard -Plan $plan -Building
-if ($left -gt 0 -and -not $Force) {
+#    ⛔ `-Force` ГЛУШИТ РОВНО ТО, ЧТО ОБЪЯВЛЯЕТ, — протухшую сборку, и ничего
+#    больше (05.09.2026, возврат случая `T80`). Прежде здесь стояло
+#    `-and -not $Force`, и это отменяло САМОПРОВЕРКУ ЦЕЛИКОМ: сторож печатал
+#    «⛔⛔ ОТКАЗ: ОСНАСТКА НЕ СООТВЕТСТВУЕТ ИСХОДНИКАМ — ПРОГОН НЕ ЗАПУСКАЕТСЯ»,
+#    а скрипт выходил кодом 0 и ставил отметку — против обещания собственной
+#    шапки. Измерено 05.09.2026: `-Force` + относительный `-Wd` → «положено 235,
+#    вынесено 233», в каталоге 2 файла, «конфигураций приборов: 0, матриц: 0»,
+#    отметка стоит, код 0. Теперь прощаются только находки `Test-AppWdBuild`
+#    (и печатаются жёлтым поимённо), а расхождение плана с копированием —
+#    отказ при любом ключе.
+$left = Invoke-AppWdGuard -Plan $plan -Building -AllowStaleBuild:$Force
+if ($left -gt 0) {
     Write-Host "⛔ САМОПРОВЕРКА ОСНАСТКИ НЕ ПРОШЛА — прогонять НЕЛЬЗЯ." -ForegroundColor Red
     Write-Host "   Отметка .appwd.json НЕ ПОСТАВЛЕНА: такую оснастку не примет и run_appwd.ps1." -ForegroundColor Red
+    if ($Force) {
+        Write-Host "   ⛔ -Force прощает ПРОТУХШУЮ СБОРКУ и только её: перечисленное выше он не глушит." -ForegroundColor Red
+    }
     exit 4
 }
 
 # Отметка — ПОСЛЕДНИМ действием и только после удачной самопроверки.
 Write-AppWdStamp -Plan $plan -Files $copied
 
-Write-Host "запуск прогона — ТОЛЬКО через сторожа:"
-Write-Host ("  pwsh `"{0}\run_appwd.ps1`" -Out `"{1}\tools\pie\out_app`"" -f $PSScriptRoot, $repo)
+# ⛔ ФОРМА ЗАПУСКА В ЭТОЙ ПОДСКАЗКЕ — ОПЕРАТОР ВЫЗОВА `&`, А НЕ `pwsh <файл>`
+#    (`T91`, 05.09.2026). До этой правки здесь печаталось `pwsh "<путь>\
+#    run_appwd.ps1" -Out …` — ровно та форма, которую `run_appwd.ps1` запрещает
+#    своей шапкой и ловит отказом 65: при запуске ФАЙЛОМ аргументы разбирает
+#    командная строка, а не PowerShell-парсер, и массив `-Extra` схлопывается
+#    в один токен. С одним ключом разницы не видно, со второго ломается молча.
+#    Официальный следующий шаг, напечатанный неверной формой, — это учебник,
+#    который учит граблям.
+Write-Host "запуск прогона — ТОЛЬКО через сторожа (звать оператором вызова & из текущей сессии, T84):"
+Write-Host ("  & '{0}\run_appwd.ps1' -Out '{1}\tools\pie\out_app'" -f $PSScriptRoot, $repo)
+Write-Host "  ключи пробы — массивом: -Extra '--band=whole','--only=ASN16_Cs137'"
 Write-Host "проверить оснастку отдельно:"
-Write-Host ("  pwsh `"{0}\check_appwd.ps1`"" -f $PSScriptRoot)
+Write-Host ("  & '{0}\check_appwd.ps1'" -f $PSScriptRoot)
