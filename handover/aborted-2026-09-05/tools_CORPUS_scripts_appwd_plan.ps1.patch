+#    сравнивает `Dst` из плана с `FullName` обхода каталога СТРОКАМИ, а обход
+#    идёт от `Resolve-Path`, то есть от АБСОЛЮТНОГО пути. Дай плану
+#    относительный `-Wd tools\CORPUS\scripts\wd_app_c6` — и ни один `Dst` не
+#    совпадёт: вся оснастка объявляется посторонней. Опыт: `mk_appwd.ps1`
+#    положил 235 файлов и тут же ВЫНЕС 233 своим же `Remove-AppWdExtra`,
+#    оставив каталог из двух файлов, «конфигураций приборов: 0, матриц: 0», —
+#    и поставил отметку. Тот же вызов с абсолютным `-Wd`: вынесено 0,
+#    конфигураций 24, матриц 5.
+#    ⚠ Чинится в ДВУХ местах нарочно: пути нормализуются на входе в план, и
+#      сравнение в `Get-AppWdExtra` идёт по `GetFullPath` обеих сторон. Первое
+#      закрывает причину, второе — тот же класс беды, если путь придёт мимо
+#      плана (`..\`, короткое имя 8.3, лишний слэш).
+function Resolve-AppWdPath {
+    param([Parameter(Mandatory)][AllowEmptyString()][string]$Path)
+    if (-not $Path) { return $Path }
+    if (-not [System.IO.Path]::IsPathRooted($Path)) {
+        $Path = Join-Path (Get-Location).ProviderPath $Path
+    }
+    [System.IO.Path]::GetFullPath($Path)
+}
