+# ⛔ ПРИЁМКА ПЕРЕДАЧИ КЛЮЧЕЙ (`T84`; заведена 05.09.2026). Ставит три опыта на
+#    КОПИИ блока `param()` из `run_appwd.ps1` и говорит числом, сколько ключей
+#    доехало до потребителя при каждом способе запуска. Опыт с ОДНИМ ключом
+#    проходит всегда — им дефект и не ловится; ломается со второго, поэтому
+#    берутся один, два и три.
+#
+#    ⚠ Приёмка обязана ОТКАЗЫВАТЬ на заведомо плохом входе, иначе она меряет
+#      пустоту: сюда же подбрасываются склеенный токен, ключ с пробелом и ключ
+#      без `--`, и мерка `Get-AppWdGluedExtra` — та самая, что стоит на пути
+#      прогона, — обязана назвать каждый.
+function Test-AppWdExtraPassing {
+    param()
+
+    $tmp = Join-Path ([IO.Path]::GetTempPath()) ("appwd_extra_" + [Guid]::NewGuid().ToString('N').Substring(0, 8) + '.ps1')
+    @'
+param([string[]]$Extra = @(), [Parameter(ValueFromRemainingArguments = $true)][string[]]$Rest)
+Write-Output ("extra={0} rest={1}" -f @($Extra).Count, @($Rest).Count)
+'@ | Set-Content -LiteralPath $tmp -Encoding utf8
+
+    $res = [System.Collections.Generic.List[object]]::new()
+    try {
+        foreach ($k in 1..3) {
+            $keys = @('--band=whole', '--only=ASN16_Cs137', '--share-thr=0.30')[0..($k - 1)]
+            $lit  = ($keys | ForEach-Object { "'" + $_ + "'" }) -join ','
+
+            $good = & $tmp -Extra $keys
+            $viaCommand = pwsh -NoProfile -Command "& '$tmp' -Extra $lit"
+            $viaFile    = pwsh -NoProfile -File $tmp -Extra ($keys -join ',')
+
+            foreach ($row in @(
+                @{ How = "& <файл> из сессии";                 Out = $good;       Want = $k }
+                @{ How = 'pwsh -NoProfile -Command "& <файл>"'; Out = $viaCommand; Want = $k }
+                @{ How = 'pwsh -File <файл> (ЗАПРЕЩЕНО)';       Out = $viaFile;    Want = 1 }
+            )) {
+                $got = 0
+                if ("$($row.Out)" -match 'extra=(\d+)') { $got = [int]$Matches[1] }
+                $res.Add([pscustomobject]@{ Keys = $k; How = $row.How; Got = $got; Want = $row.Want })
+            }
+        }
+    } finally { Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue }
+    @($res)
+}
