+# ⛔ СТОРОЖ ПУТИ ЗАПУСКА (`T68`, `T91`; заведён 05.09.2026).
+#
+# Сторож оснастки стережёт КАТАЛОГ, а щель `T68` не в каталоге: `run_appwd.ps1`
+# не пускает пробу на протухшей оснастке, но `cd wd_app; .\CorpusFsaProbe.exe …`
+# идёт мимо него — и именно эту команду печатают README и памятки. Щель не в
+# коде, а в том, что ДОКУМЕНТИРОВАННЫЙ путь — обходной. Пока правило жило
+# словами, оно и оставалось словами: `sweep_s57.ps1:27` берёт путь к пробе
+# напрямую и гоняет её по всей развёртке порогов — автоматический потребитель,
+# мимо сторожа, месяцами.
+#
+# Здесь то же правило записано МАШИННО: сторож обходит дерево и называет
+# каждое место, где пробу зовут напрямую или где обёртку зовут запрещённой
+# формой `pwsh <файл>.ps1` (`T84`: аргументы разбирает командная строка, массив
+# `-Extra` схлопывается со второго ключа).
+#
+# ⚠ Что сюда НЕ входит и почему: ЖУРНАЛЫ (`handover*`, `*journal*`). Журнал —
+#   запись того, как было сделано тогда, и переписывать его задним числом
+#   нельзя; учит же тот, кто говорит «делай так»: `README.md` и скрипты.
+#   Строка, которой правило не писано (пример разбора, чужой каталог), метится
+#   в самом файле словом `appwd-ok` — молчаливых исключений в коде нет.
+function Test-AppWdCallers {
+    param([Parameter(Mandatory)][string]$Repo)
+
+    $repo = Resolve-AppWdPath $Repo
+    $mine = @('appwd_plan.ps1', 'mk_appwd.ps1', 'run_appwd.ps1', 'check_appwd.ps1')
+    $files = @(Get-ChildItem (Join-Path $repo 'tools') -Recurse -File -Force -ErrorAction SilentlyContinue |
+               Where-Object { $_.Extension -in @('.ps1', '.py', '.cmd', '.sh', '.md') } |
+               Where-Object { $_.Name -notin $mine } |
+               Where-Object { $_.Name -notmatch 'handover|journal' })
+
+    $bad = [System.Collections.Generic.List[object]]::new()
+    foreach ($f in $files) {
+        $inCorpus = $f.FullName.ToLowerInvariant().Contains('\tools\corpus\')
+        $n = 0
+        foreach ($line in (Get-Content -LiteralPath $f.FullName -Encoding utf8 -ErrorAction SilentlyContinue)) {
+            $n++
+            if ($line -match 'appwd-ok') { continue }
+            $why = $null
+            # ⚠ ОТКАЗ — там, где ЛОМАЕТСЯ, заметка — где только некрасиво.
+            #   У `mk_appwd.ps1` массивных параметров нет, и форма `pwsh <файл>`
+            #   ему ничего не портит: правило единое, но сторож, который
+            #   краснеет на безвредном, перестают читать.
+            $deny = $true
+            if ($line -match '\.\\CorpusFsaProbe\.exe' -or $line -match '&\s*[^\r\n]*CorpusFsaProbe\.exe') {
+                $why = 'проба зовётся НАПРЯМУЮ, мимо сторожа оснастки (T68)'
+            } elseif ($inCorpus -and $line -match '\$\w+\s*=\s*[^\r\n]*CorpusFsaProbe\.exe') {
+                $why = 'путь к пробе кладётся в переменную — так её зовут мимо сторожа (T68)'
+            } elseif ($line -match 'pwsh[^\r\n]*(run_appwd|run_mini)\.ps1' -and $line -notmatch '-Command') {
+                $why = 'обёртка зовётся ФАЙЛОМ: массив -Extra схлопывается со второго ключа (T84)'
+            } elseif ($line -match 'pwsh[^\r\n]*mk_appwd\.ps1' -and $line -notmatch '-Command') {
+                $why = 'запуск ФАЙЛОМ; у mk_appwd.ps1 массивов нет, поэтому заметка, а не отказ (T91)'
+                $deny = $false
+            }
+            if ($why) {
+                $bad.Add([pscustomobject]@{
+                    File = $f.FullName.Substring($repo.Length).TrimStart('\')
+                    Line = $n
+                    Text = $line.Trim()
+                    Why  = $why
+                    Deny = $deny
+                })
+            }
+        }
+    }
+    @($bad)
+}
