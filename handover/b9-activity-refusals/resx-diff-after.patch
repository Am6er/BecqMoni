--- a/BecquerelMonitor/Properties/Resources.resx
+++ b/BecquerelMonitor/Properties/Resources.resx
@@ -42811,6 +42811,15 @@ Device channels: {0}, spectrum files channels: {1}</value>
   <data name="ActivityLowYieldRefused" xml:space="preserve">
     <value>line yield below {0:0.#} % per decay: activity not shown</value>
   </data>
+  <data name="ActivityOutOfCurveRefused" xml:space="preserve">
+    <value>{0:0.##} keV is outside the efficiency curve ({1:0.##} to {2:0.##} keV): activity not shown</value>
+  </data>
+  <data name="ActivityNoEpsilonRefused" xml:space="preserve">
+    <value>the efficiency curve gives no value at {0:0.##} keV: activity not shown</value>
+  </data>
+  <data name="ActivityNoBackgroundRefused" xml:space="preserve">
+    <value>no background spectrum: activity not shown</value>
+  </data>
   <data name="BqCoeffTipAuto" xml:space="preserve">
     <value>K converts the count rate into becquerels: Bq = cps * K. Ticked, it is computed from the efficiency curve chosen for the spectrum and the Intensity of this zone: K = 100 / (efficiency * Intensity). Unticked, the number in the field is used, as before. The stored number stays either way and is used when there is no curve.</value>
   </data>
